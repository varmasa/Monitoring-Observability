 Features

Headlamp provides:

Cluster overview
Node information
Namespace management
Deployments
ReplicaSets
StatefulSets
DaemonSets
Pods
Services
Ingresses
ConfigMaps
Secrets
PersistentVolumes
PersistentVolumeClaims
Jobs
CronJobs
Events
Logs
YAML editor
Terminal into Pods
Resource usage (if Metrics Server is installed)




helm repo add headlamp https://kubernetes-sigs.github.io/headlamp/
helm repo update

helm install headlamp headlamp/headlamp \
-n headlamp \
--create-namespace


kubectl port-forward svc/headlamp -n headlamp 8085:80 --address 0.0.0.0

headlamp-admin.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: headlamp-admin
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: headlamp-admin
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: ServiceAccount
  name: headlamp-admin
  namespace: kube-system


  kubectl apply -f headlamp-admin.yaml
  kubectl -n kube-system create token headlamp-admin

  Access Headlamp
